# Inflexion Site Intelligence - Environment Configuration
# Copy to .env and fill in values

# TypeSafe API Key for Jev atomic question evaluations
# Create at: https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Site root path (default: ~/Projects/04-inflexion/08-Website)
SITE_ROOT=~/Projects/04-inflexion/08-Website

# LLM API Key for interpretation layer (optional, falls back to local analysis)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini