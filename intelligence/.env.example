# Inflexion Intelligence Engine — Environment Configuration
# Copy to .env and fill in values

# TypeSafe API Key for Jev atomic question evaluations
# Create at: https://console.typesafe.ai/
TYPESAFE_API_KEY=your_typesafe_api_key_here

# OpenAI API Key for LLM interpretation layer
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google Search Console / Analytics for performance data
# GSC_CREDENTIALS_PATH=path/to/gsc-credentials.json
# GA4_PROPERTY_ID=G-XXXXXXXXXX